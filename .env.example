# https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-key-here

# 可选：Hacker News 快照 JSON 输出路径（也可用命令行 -o）
# HN_JSON_OUT=hn-snapshot.json

# 可选：默认抓取热门榜前几条（正整数）；命令行 -n 或位置参数 N 可覆盖
# HN_TOP_N=12

# 设为 1 时：不 HTTP 请求 story.url 抓取正文，文章摘要仅依据标题与 HN 站内文/评论
# HN_SKIP_ARTICLE_FETCH=1

# HN Firebase API 易在弱网/IPv6 下连接超时（默认 Undici 仅 10s）。可加大：
# HN_CONNECT_TIMEOUT_MS=60000
# HN_BODY_TIMEOUT_MS=120000
# HN_FETCH_RETRIES=3
